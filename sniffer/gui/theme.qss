QMenuBar, QToolBar, QStatusBar {
    background: #f3f7f7;
}
QMenuBar::item { padding: 5px 9px; border-radius: 4px; }
QMenuBar::item:selected, QMenu::item:selected, QToolButton:hover { background: #e0efed; color: #183133; }
QMenu { background: #ffffff; border: 1px solid #cddbdc; padding: 4px; }
QMenu::item { padding: 5px 24px 5px 22px; }
QMenu::separator { height: 1px; margin: 4px 8px; background: #dce6e6; }
QToolBar { padding: 5px 7px; spacing: 4px; border: 0; border-bottom: 1px solid #dce6e6; }
QToolBar::separator { background: #cedcdd; width: 1px; margin: 5px 3px; }
QToolButton { border: 1px solid transparent; border-radius: 4px; padding: 4px 5px; }
QToolButton:pressed, QToolButton:checked { background: #cde8e5; }
QPushButton, QLineEdit, QComboBox, QSpinBox {
    background: #ffffff; border: 1px solid #c7d6d7; border-radius: 4px; padding: 4px 8px;
}
QComboBox { padding-right: 23px; }
QComboBox::drop-down { subcontrol-origin: border; subcontrol-position: top right; width: 22px; border: 0; }
QComboBox::down-arrow, QSpinBox::down-arrow { image: url("@ICONS@/chevron-down.svg"); width: 12px; height: 12px; }
QComboBox QLineEdit { border: 0; padding: 1px 3px; }
QSpinBox { padding-right: 20px; }
QSpinBox::up-button, QSpinBox::down-button { subcontrol-origin: border; width: 18px; border: 0; }
QSpinBox::up-button { subcontrol-position: top right; }
QSpinBox::down-button { subcontrol-position: bottom right; }
QSpinBox::up-arrow { image: url("@ICONS@/chevron-up.svg"); width: 12px; height: 12px; }
QPushButton:hover { background: #e8f4f2; border-color: #8ab9b5; }
QPushButton:pressed { background: #d4ece9; }
QPushButton:focus, QPushButton:default, QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border-color: #007a78; }
QPushButton:disabled, QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled {
    background: #eef3f3; border-color: #dee7e7;
}
QHeaderView { background: #edf3f3; }
QHeaderView::section {
    background: #edf3f3; color: #344e50; padding: 5px 8px;
    border: 0; border-right: 1px solid #e0e9e9; border-bottom: 1px solid #d3e0e1;
}
QTableView, QTreeView, QPlainTextEdit { border: 1px solid #d3e0e1; }
QSplitter::handle { background: #e0e9e9; }
QSplitter::handle:hover { background: #9ac9c6; }
QScrollBar:vertical { width: 10px; background: #f0f5f5; margin: 0; }
QScrollBar:horizontal { height: 10px; background: #f0f5f5; margin: 0; }
QScrollBar::handle { background: #a5bcbc; border-radius: 4px; margin: 1px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: #658987; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QTabWidget::pane { border: 1px solid #d3e0e1; background: #ffffff; }
QTabBar::tab {
    background: #eaf1f1; color: #3f595b; border: 1px solid #d3e0e1;
    border-top-left-radius: 4px; border-top-right-radius: 4px; padding: 5px 14px;
}
QTabBar::tab:selected { background: #ffffff; color: #007a78; border-bottom-color: #007a78; }
QStatusBar { border-top: 1px solid #dce6e6; }
QStatusBar::item { border: 0; }
QLabel#versionBadge { background: #dcedeb; color: #006663; border-radius: 4px; padding: 3px 8px; }
QLabel#welcomeDescription { color: #385456; }
QLabel#welcomeHint { color: #536c6d; }
